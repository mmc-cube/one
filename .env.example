# 复制为 .env 后，只需填写 DeepSeek Key。不要将 .env 提交或放进前端目录。
AI_API_KEY=

AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=60
AI_JSON_MODE=true
AI_THINKING=disabled

# 服务器监听地址和端口
MCU_HOST=127.0.0.1
MCU_PORT=43210

# 元器件资料库文件夹路径（导出硬件资料包功能需要）
MCU_LIB_BASE=D:/niuma_modules_extracted

# 商家端功能说明策略：fixed=本地元器件库固定句，ai=结合题目动态生成
COMPONENT_DESCRIPTION_MODE=fixed

# 管理后台：http://127.0.0.1:43210/admin
# 对外部署前必须设置强密码；HTTPS 部署时把 ADMIN_SECURE_COOKIE 改为 true。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECONDS=28800
ADMIN_SECURE_COOKIE=false
