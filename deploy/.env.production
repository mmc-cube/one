# ==========================================
# 白砾电子 — 生产环境配置模板
# 复制此文件到项目根目录并重命名为 .env
# ==========================================

# ---- AI 配置（必填）----
AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=60
AI_JSON_MODE=true
AI_THINKING=disabled

# ---- 服务器 ----
MCU_HOST=127.0.0.1
MCU_PORT=43210

# ---- 元器件资料库路径（必填）----
MCU_LIB_BASE=/data/niuma_modules_extracted

# ---- 管理员（生产环境务必修改密码）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为强密码至少16位
ADMIN_SESSION_SECONDS=28800
ADMIN_SECURE_COOKIE=true

# ---- 功能开关 ----
COMPONENT_DESCRIPTION_MODE=fixed
