[Unit]
Description=白砾电子 MCU 选题评估平台
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/baili-electronics
EnvironmentFile=/opt/baili-electronics/.env
ExecStart=/opt/baili-electronics/venv/bin/python -c "\
from waitress import serve; \
from backend.server import AppHandler; \
import os; \
host = os.environ.get('MCU_HOST', '127.0.0.1'); \
port = int(os.environ.get('MCU_PORT', '43210')); \
serve(AppHandler, host=host, port=port, threads=8)"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
